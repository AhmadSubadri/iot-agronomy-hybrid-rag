# Konfigurasi Database MySQL (Default ke DB duplikat eksperimen agar DB asli tetap murni)
KT_DB_HOST=localhost
KT_DB_PORT=3306
KT_DB_USER=root
KT_DB_PASSWORD=
KT_DB_NAME=kawaltani_rag_tesis

# Konfigurasi Model Embedding Bahasa Indonesia / Multilingual
KT_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Konfigurasi Model LLM Default (openai | gemini | ollama | groq | openrouter)
KT_LLM_PROVIDER=openai
KT_LLM_MODEL=gpt-4o-mini
KT_LLM_TEMPERATURE=0.1

# Isi API Key sesuai provider yang digunakan untuk A/B Testing (Bab 3.9.3 Proposal)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_HOST=http://localhost:11434
GROQ_API_KEY=
OPENROUTER_API_KEY=

